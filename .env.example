DATABASE_URL=postgres://localhost:5432/gabos
# Required for Payload in production. See docs/design-preview-deploy.md for preview-without-CMS.
PAYLOAD_SECRET=replace-with-a-long-random-string

# Point local `npm run dev` at Railway Postgres: sync with `npm run railway:sync-env`, then set true.
GABOS_USE_LIVE_DATABASE=false
DATABASE_URL_LIVE=
PAYLOAD_SECRET_LIVE=

# Vercel (static design preview): set GABOS_STATIC_PREVIEW=true — do not use Payload there.
# Railway (CMS + Postgres): set PAYLOAD_SECRET + DATABASE_URL only; leave GABOS_STATIC_PREVIEW unset.
# Optional for scripts: RAILWAY_TOKEN from https://railway.app/account/tokens (do not commit)
# GABOS_STATIC_PREVIEW=true
SEED_EMAIL=editor@gabos.test
SEED_PASSWORD=choose-a-password

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` or Dashboard webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
