# WordPress theme deploy (npm run deploy:theme)
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
# false, true (explicit FTPS), or implicit
FTP_SECURE=false
# Directory of the gabos-2026 theme on the server.
# Relative paths start from the FTP login folder. Absolute paths start at the FTP root.
FTP_REMOTE_DIR=/public_html/wp-content/themes/gabos-2026

# Shop checkout
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
